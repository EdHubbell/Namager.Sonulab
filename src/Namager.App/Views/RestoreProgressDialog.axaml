<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Namager.App.Views.RestoreProgressDialog"
        Title="Restoring presets"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource Sonulab.SurfaceBrush}">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Text="Starting…"/>
    <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="1"/>
    <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Right" Click="OnCancelClick"/>
  </StackPanel>
</Window>
