<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Namager.App.Views.ConfirmDialog"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Sonulab.SurfaceBrush}">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick"/>
      <Button x:Name="ConfirmButton" Classes="accent-outline" Content="OK" Click="OnConfirmClick"/>
    </StackPanel>
  </StackPanel>
</Window>
