<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Namager.App.Views.RestoreConfirmDialog"
        Title="Restore Snapshot"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Sonulab.SurfaceBrush}">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
    <CheckBox x:Name="BackupCheck" Content="Back up current pedal state first (about 3 minutes)" IsChecked="True"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick"/>
      <Button x:Name="RestoreButton" Classes="accent-outline" Content="Restore" Click="OnRestoreClick"/>
    </StackPanel>
  </StackPanel>
</Window>
